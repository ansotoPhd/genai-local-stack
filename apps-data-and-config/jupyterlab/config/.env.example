# Plantilla de variables de JupyterLab. install.sh la copia a .env (local, ignorado por git).
# Estas variables llegan a los kernels: OpenAI() en un notebook usa LiteLLM sin más configuración.

OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# Master key de LiteLLM (setup.sh la rellena si está vacía).
OPENAI_API_KEY=

JUPYTER_PORT=8888

# Postgres del stack, BD genai con pgvector (setup.sh la rellena si está vacía).
DATABASE_URL=

# OpenTelemetry: el SDK de los notebooks exporta a otel-lgtm (setup.sh rellena el endpoint).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=jupyterlab

# Hindsight: URL de la API (setup.sh la rellena) y banco propio de los notebooks.
HINDSIGHT_API_URL=
HINDSIGHT_BANK_ID=jupyterlab
