# Plantilla de variables de opencode. install.sh la copia a .env (local, ignorado por git).

# URL de LiteLLM, sin /v1 (setup.sh la rellena desde LITELLM_PORT). La usan la config de opencode
# y el plugin opencode-litellm-provider para descubrir los modelos.
LITELLM_BASE_URL=

# Master key de LiteLLM (setup.sh la rellena si está vacía).
LITELLM_API_KEY=

# API de Hindsight (memoria a largo plazo; setup.sh la rellena).
HINDSIGHT_API_URL=

# Puerto del servidor en segundo plano de opencode. El de por defecto (49374) es el mismo para
# cualquier instalación, así que se usa uno propio. Tras cambiarlo, vuelve a ejecutar install.sh.
OPENCODE_SERVICE_PORT=49380
