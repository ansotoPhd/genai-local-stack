# Plantilla de variables de otel-lgtm. install.sh la copia a .env (local, ignorado por git).
# Todas se pasan también al contenedor.

COMPOSE_PROJECT_NAME=genai-otel-lgtm

# Puertos publicados en 127.0.0.1. OTLP usa los estándar para que los SDK funcionen sin configurar.
LGTM_GRAFANA_PORT=3000
LGTM_OTLP_GRPC_PORT=4317
LGTM_OTLP_HTTP_PORT=4318
LGTM_PROMETHEUS_PORT=9090
LGTM_TEMPO_PORT=3200
LGTM_PYROSCOPE_PORT=4040

# Logs de los componentes internos en la salida del contenedor (ver ./compose.sh logs -f).
#ENABLE_LOGS_ALL=true

# Retención (por defecto, la de cada componente).
#PROMETHEUS_EXTRA_ARGS=--storage.tsdb.retention.time=30d
