# Plantilla de variables de Postgres. install.sh la copia a .env (local, ignorado por git).

COMPOSE_PROJECT_NAME=genai-postgres

# Puerto publicado en 127.0.0.1 (no el 5432, para no chocar con otros Postgres locales).
POSTGRES_PORT=15432

POSTGRES_USER=genai
# setup.sh la genera si está vacía (y la usa en los DATABASE_URL de LiteLLM y JupyterLab: si la
# pones a mano, evita caracteres especiales de URL). Usuario, password y BD solo se aplican al
# inicializar data/ por primera vez.
POSTGRES_PASSWORD=
POSTGRES_DB=genai
