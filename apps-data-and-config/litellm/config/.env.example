# Plantilla de variables de LiteLLM. install.sh la copia a .env (local, ignorado por git).

# Clave para acceder al proxy (setup.sh la genera si está vacía).
LITELLM_MASTER_KEY=

LITELLM_PORT=4000

# Base de datos (Postgres del stack): UI de admin, virtual keys y registro de gasto.
# setup.sh la rellena si está vacía. Para usar LiteLLM sin BD, comenta la línea.
DATABASE_URL=

# Guarda en la BD los modelos que se añadan desde la UI (/ui > Models), además de los de config.yaml.
# opencode los descubre igual que los de config.yaml. Requiere DATABASE_URL.
STORE_MODEL_IN_DB=True

# OpenTelemetry hacia otel-lgtm (setup.sh rellena el endpoint si está vacío).
# Ref.: https://docs.litellm.ai/docs/observability/opentelemetry_v2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=litellm
# Integración v2: una traza por petición (HTTP, auth, llamada al modelo, BD) con la semconv GenAI.
LITELLM_OTEL_V2=true
# Solo atributos de la semconv de OpenTelemetry: sin los nombres heredados Traceloop/semconv-ai.
LITELLM_OTEL_LEGACY_COMPAT=false
# Convenciones estables de OpenTelemetry: el span HTTP raíz (instrumentación de FastAPI) usa solo
# la semconv HTTP estable (http.request.method, url.path…) en vez de la antigua (http.method…).
OTEL_SEMCONV_STABILITY_OPT_IN=http,gen_ai_latest_experimental
# Contenido de los mensajes (gen_ai.input/output.messages): no_content | span_only | event_only |
# span_and_event. En LiteLLM 1.104 la v2 solo lo escribe en el span; la parte "event" aún no existe.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=span_and_event
# Métricas gen_ai.* (Prometheus): uso de tokens, duración, coste, TTFT…
LITELLM_OTEL_INTEGRATION_ENABLE_METRICS=true
# Eventos como logs (Loki). En v2: gen_ai.client.operation.exception cuando falla una llamada.
LITELLM_OTEL_INTEGRATION_ENABLE_EVENTS=true

# Clave de OpenCode Go (suscripción): la única credencial de config.yaml. Se copia de
# https://opencode.ai/console (OpenCode Go > API key). Sin ella, /v1/models sale vacío.
OPENCODE_GO_API_KEY=
