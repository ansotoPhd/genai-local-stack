# Plantilla de variables de OpenChamber. install.sh la copia a .env (local, ignorado por git).

# Puerto de la interfaz web/PWA (3000 lo usa Grafana en este stack).
OPENCHAMBER_PORT=3010

# Contraseña de la interfaz (install.sh la genera si está vacía).
OPENCHAMBER_UI_PASSWORD=

# Duración de la sesión del navegador, en horas.
OPENCHAMBER_UI_SESSION_TTL_HOURS=12

# Directorio donde arranca el opencode que gestiona OpenChamber (proyecto por defecto).
# Vacío = <repo>/workspace.
OPENCHAMBER_OPENCODE_CWD=
