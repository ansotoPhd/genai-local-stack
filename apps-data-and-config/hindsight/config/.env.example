# Plantilla de variables de Hindsight. install.sh la copia a .env (local, ignorado por git).
# Referencia: https://hindsight.vectorize.io/developer/configuration

# Servidor (8888, el puerto por defecto de Hindsight, lo usa JupyterLab).
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8890
# UI (control plane).
HINDSIGHT_CP_PORT=9999

# BD hindsight en el Postgres del stack (setup.sh la rellena; start.sh la crea si falta).
HINDSIGHT_API_DATABASE_URL=

# LLM para extraer memorias (retain) y razonar (reflect): LiteLLM (setup.sh rellena URL y clave).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=go-deepseek-v4.1-flash

# Embeddings locales (ONNX en CPU, multilingüe) y reranking sin modelo (fusión RRF).
# La dimensión de los embeddings queda fijada en la BD: cambiar de modelo obliga a reindexar.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# Trazas OpenTelemetry hacia otel-lgtm (setup.sh rellena el endpoint).
HINDSIGHT_API_OTEL_TRACES_ENABLED=true
HINDSIGHT_API_OTEL_EXPORTER_OTLP_ENDPOINT=
HINDSIGHT_API_OTEL_SERVICE_NAME=hindsight-api
